# Frontend has no secrets — all admin auth lives on the server.
# Do NOT put passwords in VITE_* variables: they are bundled into the
# browser JavaScript and visible to anyone.
#
# Server config goes in server/.env (see server/.env.example):
#   PORT, NODE_ENV, CLIENT_URL, JWT_SECRET, ADMIN_PASSWORD_HASH
#
# Optional Vite overrides (rarely needed):
# PORT=5173
