# Server Configuration
# Copy this file to .env in the server/ directory
# NEVER commit the actual .env file

# Server
PORT=3001
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS + credentials)
CLIENT_URL=http://localhost:5173

# JWT Secret — use a strong, random string (min 32 characters)
JWT_SECRET=change-this-to-a-very-strong-random-string-at-least-32-characters

# Admin Password Hash (preferred — never store plaintext here)
# Generate with: npm run gen:hash -- "your-strong-password"
# Then paste the output below:
ADMIN_PASSWORD_HASH=

# Alternative for local dev only: plaintext password (server hashes it at
# startup and warns). NEVER set this in production — use ADMIN_PASSWORD_HASH.
# ADMIN_PASSWORD=change-me
